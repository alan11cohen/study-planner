# Provider selection:
#   auto   -> use OpenAI when OPENAI_API_KEY is set, otherwise the offline stub
#   openai -> always OpenAI (fails fast if no key)
#   stub   -> always the deterministic offline client (no network, no key)
LLM_PROVIDER=auto

#Leave empty to run fully offline with the stub.
OPENAI_API_KEY=

# Chat model used for structured task generation.
OPENAI_MODEL=gpt-4o-mini

# Optional: override the OpenAI base URL (e.g. for Azure/OpenAI-compatible gateways).
# OPENAI_BASE_URL=
